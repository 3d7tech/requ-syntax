{
  "name": "requ-syntax",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "gallery": "node scripts/gallery.mjs",
    "requ": "node packages/cli/dist/index.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:visual": "node scripts/geometry-browser.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.10",
    "eslint": "9.39.1",
    "happy-dom": "20.0.10",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
